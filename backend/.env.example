# Supabase — use the SERVICE ROLE key here (backend only, never ship to frontend)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# 32-byte (64 hex char) master key used to encrypt/decrypt user Binance API keys.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ENCRYPTION_MASTER_KEY=replace-with-64-hex-characters

# Binance
BINANCE_API_BASE=https://api.binance.com

# Server
PORT=4000
FRONTEND_ORIGIN=http://localhost:5173
